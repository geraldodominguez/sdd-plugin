#!/usr/bin/env bash
# sdd-release: conduz uma release, do agrupamento das features prontas à produção.
#
# Situações da release, em ordem:
#   preparacao -> homologacao -> aceita -> implantacao -> producao
#   e, fora da ordem: cancelada, revertida
#
# Uso:
#   sdd-release proxima [auto|major|minor|patch] [--pre alpha|beta|rc]
#                                               a próxima versão SemVer; auto (o padrão) calcula
#                                               pelos commits (Conventional Commits) desde a última versão
#   sdd-release analisar                        os commits desde a última versão, o impacto de cada
#                                               um e a versão sugerida, com o motivo
#   sdd-release changelog <versão> [--escrever] a seção da versão no formato Keep a Changelog,
#                                               a partir dos commits; --escrever grava no CHANGELOG.md
#   sdd-release nova <versão> [--objetivo "texto"] [--hotfix]
#   sdd-release incluir <versão> <NNN-slug> [...]   só features prontas, na preparação
#   sdd-release remover <versão> <NNN-slug>         só na preparação
#   sdd-release homologar <versão>              preparacao -> homologacao (exige testes.md aprovado
#                                               e homologacao.md com o roteiro)
#   sdd-release aceitar <versão> --por "Nome e papel" [--nota "texto"]
#                                               registra o aceite do negócio (roteiro sem pendências)
#   sdd-release reprovar <versão> <NNN-slug> --motivo "texto"
#                                               devolve a feature ao green e a release à preparação
#   sdd-release autorizar <versão> [--nota "texto"]
#                                               o go/no-go: aceita -> implantacao (exige
#                                               implantacao.md e notas.md completos)
#   sdd-release pode-implantar <versão>         saída 0 se autorizada (para o pipeline)
#   sdd-release concluir <versão> --verificacao "texto"
#                                               implantacao -> producao; features em produção
#   sdd-release reverter <versão> --motivo "texto"
#                                               rollback: features voltam a pronta
#   sdd-release cancelar <versão> --motivo "texto"
#   sdd-release ver [versão] | listar | atual
set -euo pipefail

AQUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/sdd-comum.sh
. "$AQUI/../lib/sdd-comum.sh"
case "${1:-}" in -h|--ajuda|--help) sdd_ajuda "$0"; exit 0 ;; esac

RAIZ="$(sdd_raiz_projeto)"
[ -d "$RAIZ/.sdd" ] || { echo "sdd-release: este projeto ainda não usa SDD. Rode /sdd:iniciar." >&2; exit 1; }
PASTA="$(sdd_pasta_releases "$RAIZ")"
DIR="$RAIZ/$PASTA"
PASTA_SPECS="$(sdd_pasta_specs "$RAIZ")"
HOJE="$(date +%Y-%m-%d)"

dir_de() { printf '%s\n' "$DIR/$1"; }
existe() { [ -f "$DIR/$1/release.md" ] || { echo "sdd-release: a release '$1' não existe em $PASTA/." >&2; exit 1; }; }
situacao() { sdd_kv_ler "$DIR/$1/estado" fase; }

historico() { # historico <versão> <evento> <detalhe>
  local arq="$DIR/$1/historico.md"
  if [ ! -s "$arq" ]; then
    printf '# Histórico da release %s\n\n> Gerado pelos utilitários do SDD. Não edite à mão.\n\n' "$1" > "$arq"
  fi
  printf -- '- %s | %s | %s | por: %s\n' "$(sdd_agora)" "$2" "$3" "$(sdd_autor)" >> "$arq"
  sdd_registrar "$RAIZ" "" release "$1 $2: $3"
}

mudar_situacao() { # mudar_situacao <versão> <nova> <nota>
  local antiga
  antiga="$(situacao "$1")"
  sdd_kv_gravar "$DIR/$1/estado" fase "$2"
  sdd_kv_gravar "$DIR/$1/estado" atualizado "$(sdd_agora)"
  sdd_md_gravar_campo "$DIR/$1/release.md" "Situação" "$2"
  historico "$1" situacao "$antiga para $2${3:+ ($3)}"
}

exige() { # exige <versão> <situação esperada...>
  local v="$1" atual s; shift
  atual="$(situacao "$v")"
  for s in "$@"; do [ "$atual" = "$s" ] && return 0; done
  echo "sdd-release: a release $v está em '$atual'. Esta ação exige: $*." >&2
  exit 1
}

features() { # features <versão>: uma por linha
  awk '/^## Features/ { dentro = 1; next } /^## / { dentro = 0 } dentro && /^- / { sub(/^- /, ""); sub(/ .*/, ""); print }' "$DIR/$1/release.md"
}

reescrever_features() { # reescrever_features <versão> <lista>
  local arq tmp
  arq="$DIR/$1/release.md"; tmp="$arq.tmp.$$"
  LISTA="$2" awk '
    BEGIN { lista = ENVIRON["LISTA"] }
    /^## Features/ {
      print; print ""
      n = split(lista, a, "\n"); vazio = 1
      for (i = 1; i <= n; i++) if (a[i] != "") { print "- " a[i]; vazio = 0 }
      if (vazio) print "_Nenhuma feature ainda. Use /sdd:release para incluir as prontas._"
      print ""; pular = 1; next
    }
    pular && /^## / { pular = 0 }
    pular { next }
    { print }
  ' "$arq" > "$tmp"
  mv "$tmp" "$arq"
}

versoes() { # versões existentes, em ordem SemVer crescente
  [ -d "$DIR" ] || return 0
  local d
  for d in "$DIR"/*/; do
    [ -f "$d/release.md" ] && basename "$d"
  done | ordenar_semver
}

ordenar_semver() { # lê versões (uma por linha) e as imprime em ordem SemVer crescente
  awk 'NF {
    # Chave de ordenação: o pré-lançamento (1.3.0-rc.1) vem antes da final, e os
    # identificadores numéricos dele se comparam como números (rc.2 < rc.10).
    v = $0; base = v; pre = ""
    i = index(v, "-"); if (i) { base = substr(v, 1, i - 1); pre = substr(v, i + 1) }
    split(base, n, ".")
    k = ""
    m = split(pre, p, ".")
    for (j = 1; j <= m; j++) k = k (j > 1 ? "." : "") (p[j] ~ /^[0-9]+$/ ? sprintf("%09d", p[j]) : p[j])
    printf "%09d %09d %09d %d %s %s\n", n[1], n[2], n[3], (pre == "" ? 1 : 0), (k == "" ? "-" : k), v
  }' | sort | awk '{ print $NF }'
}

ultima_em_producao() {
  local v ult=""
  # Um pré-lançamento nunca é a referência da próxima versão.
  for v in $(versoes); do
    case "$v" in *-*) continue ;; esac
    # Com o go (implantacao), a versão já foi para main com a tag: ela também é
    # a referência (um hotfix aberto antes do concluir sai da versão seguinte).
    case "$(situacao "$v")" in producao|implantacao) ult="$v" ;; esac
  done
  printf '%s\n' "$ult"
}

roteiro_ok() { # roteiro_ok <versão>: imprime o problema, se houver
  local arq="$DIR/$1/homologacao.md" linhas
  linhas="$( { grep -E '^\| H-[0-9]+ ' "$arq" || true; } )"
  if [ -z "$linhas" ]; then echo "homologacao.md não tem passos (linhas | H-NNN |)"; return; fi
  if printf '%s\n' "$linhas" | grep -qE '\| *pendente *\|[[:space:]]*$'; then echo "há passos pendentes no roteiro de homologação"; return; fi
  if printf '%s\n' "$linhas" | grep -qE '\| *reprovado *\|[[:space:]]*$'; then echo "há passos reprovados no roteiro de homologação (use 'sdd-release reprovar')"; return; fi
  if grep -q '{{' "$arq"; then echo "homologacao.md ainda tem campos {{...}}"; fi
  return 0
}

transicionar_features() { # transicionar_features <versão> <fase> <nota>
  local f
  for f in $(features "$1"); do
    "$AQUI/sdd-estado" transicionar "$f" "$2" "$3" >/dev/null
  done
}

# ---------------------------------------------------------------------------
# Versão automática (SemVer pelos Conventional Commits) e changelog
# ---------------------------------------------------------------------------

# A versão de referência: a última em produção; sem nenhuma, a última tag
# vX.Y.Z alcançável a partir de HEAD.
versao_base() {
  # A maior entre a última release em produção (ou com o go) e a última tag
  # vX.Y.Z final alcançável: uma versão revertida já tem tag em main, e a
  # próxima não pode andar para trás.
  local ult tag
  ult="$(ultima_em_producao)"
  tag="$(ultima_tag)"; tag="${tag#v}"
  sdd_semver_valida "$tag" 2>/dev/null || tag=""
  printf '%s\n%s\n' "$ult" "$tag" | ordenar_semver | tail -1
  return 0
}

# A última tag de versão final (vX.Y.Z, sem pré-lançamento) alcançável de HEAD.
ultima_tag() {
  git -C "$RAIZ" describe --tags --abbrev=0 --match 'v[0-9]*' --exclude 'v*-*' 2>/dev/null || true
}

# De onde contar os commits: a tag da versão de referência, se existir; senão a
# última tag alcançável; sem tag nenhuma, o histórico inteiro (vazio).
ref_base() {
  local v="$1"
  if [ -n "$v" ] && git -C "$RAIZ" rev-parse -q --verify "refs/tags/v$v" >/dev/null 2>&1; then
    printf 'v%s\n' "$v"; return
  fi
  ultima_tag
}

# impacto_maximo: lê as linhas do sdd_cc_commits e imprime o maior impacto.
impacto_maximo() {
  awk -F '\t' '
    $1 == "major" { m = 3 } $1 == "minor" && m < 2 { m = 2 } $1 == "patch" && m < 1 { m = 1 }
    END { if (m == 3) print "major"; else if (m == 2) print "minor"; else if (m == 1) print "patch"; else print "nenhum" }'
}

# O tipo de incremento que os commits pedem. Antes da 1.0.0, a mudança
# incompatível sobe o minor (a API ainda não é estável); sem feat nem fix, patch.
incremento_automatico() { # incremento_automatico <versão base> <impacto>
  case "$2" in
    major) case "$1" in 0.*) echo minor ;; *) echo major ;; esac ;;
    minor) echo minor ;;
    *) echo patch ;;
  esac
}

proxima_versao() { # proxima_versao <auto|major|minor|patch> [id de pré-lançamento]
  local tipo="$1" pre="${2:-}" base ref imp prox n
  base="$(versao_base)"
  if [ -z "$base" ]; then
    case "$tipo" in major) prox="1.0.0" ;; *) prox="0.1.0" ;; esac
  else
    if [ "$tipo" = "auto" ]; then
      ref="$(ref_base "$base")"
      imp="$(sdd_cc_commits "$RAIZ" "$ref" | impacto_maximo)"
      tipo="$(incremento_automatico "$base" "$imp")"
    fi
    prox="$(sdd_semver_somar "$base" "$tipo")"
  fi
  # Uma versão já usada (pasta em releases/, tag, ou branch release/ ou hotfix/
  # reservada) não se repete: uma release cancelada, por exemplo, guarda o número.
  while [ -z "$pre" ] && { [ -d "$DIR/$prox" ] \
      || git -C "$RAIZ" rev-parse -q --verify "refs/tags/v$prox" >/dev/null 2>&1 \
      || git -C "$RAIZ" show-ref --verify --quiet "refs/heads/release/$prox" 2>/dev/null \
      || git -C "$RAIZ" show-ref --verify --quiet "refs/heads/hotfix/$prox" 2>/dev/null; }; do
    prox="$(sdd_semver_somar "$prox" patch)"
  done
  if [ -n "$pre" ]; then
    printf '%s' "$pre" | grep -qE '^[0-9A-Za-z-]+$' || { echo "sdd-release proxima: identificador de pré-lançamento inválido: $pre" >&2; exit 1; }
    # O número do pré-lançamento segue o maior já usado, em tag ou em releases/.
    n="$( { git -C "$RAIZ" tag --list "v$prox-$pre.*" 2>/dev/null | sed -E "s/^v//"
            for d in "$DIR/$prox-$pre".*/; do if [ -d "$d" ]; then basename "$d"; fi; done
            true
          } | sed -E "s/^$prox-$pre\.//" | { grep -E '^[0-9]+$' || true; } | sort -n | tail -1)"
    prox="$prox-$pre.$(( ${n:-0} + 1 ))"
  fi
  printf '%s\n' "$prox"
}

analisar() {
  local base ref linhas imp tipo prox total
  base="$(versao_base)"; ref="$(ref_base "$base")"
  linhas="$(sdd_cc_commits "$RAIZ" "$ref")"
  total="$(printf '%s\n' "$linhas" | grep -c . || true)"
  if [ -n "$base" ]; then
    echo "Versão atual: $base${ref:+ (commits desde $ref)}"
  else
    echo "Nenhuma versão anterior: a primeira é 0.1.0 (ou 1.0.0, se a API já nasce estável)."
  fi
  echo "Commits (sem os merges): $total"
  conta() { printf '%s\n' "$linhas" | awk -F '\t' -v c="$1" '$1 == c' | grep -c . || true; }
  echo "  incompatíveis (major): $(conta major)"
  echo "  feat (minor):          $(conta minor)"
  echo "  fix e perf (patch):    $(conta patch)"
  echo "  sem impacto na versão: $(printf '%s\n' "$linhas" | awk -F '\t' '$1 == "nenhum" && $2 != "outro"' | grep -c . || true)"
  local fora
  fora="$(printf '%s\n' "$linhas" | awk -F '\t' '$2 == "outro" { print "    - " $4 }')"
  if [ -n "$fora" ]; then
    echo "  fora do Conventional Commits (não contam): $(printf '%s\n' "$fora" | grep -c . || true)"
    printf '%s\n' "$fora"
  fi
  if [ -z "$base" ]; then
    echo "Sugestão: 0.1.0"; return 0
  fi
  imp="$(printf '%s\n' "$linhas" | impacto_maximo)"
  tipo="$(incremento_automatico "$base" "$imp")"
  prox="$(sdd_semver_somar "$base" "$tipo")"
  case "$imp" in
    major) case "$base" in 0.*) motivo="há mudança incompatível, e antes da 1.0.0 ela sobe o minor" ;; *) motivo="há mudança incompatível (! ou BREAKING CHANGE)" ;; esac ;;
    minor) motivo="há feat e nenhuma mudança incompatível" ;;
    patch) motivo="só fix ou perf" ;;
    *) motivo="nenhum feat nem fix: só manutenção" ;;
  esac
  echo "Sugestão: $prox ($tipo: $motivo)"
  local det
  det="$(printf '%s\n' "$linhas" | awk -F '\t' 'NF && $1 != "nenhum" { printf "  [%s] %s%s: %s\n", $1, $2, ($3 != "-" ? "(" $3 ")" : ""), $4 }')"
  [ -n "$det" ] && { echo "Commits que mudam a versão:"; printf '%s\n' "$det"; }
  return 0
}

# O título de uma feature pelo número (escopo do commit), ou vazio.
titulo_feature() {
  local num="$1" d t
  printf '%s' "$num" | grep -qE '^[0-9]{3}$' || return 0
  for d in "$RAIZ/$PASTA_SPECS/$num"-*/; do
    [ -d "$d" ] || continue
    t="$(head -1 "$d/spec.md" 2>/dev/null | sed -nE 's/^# Spec [^:]*: (.*)$/\1/p')"
    # Sem título na spec, o título com que a feature foi criada (no histórico).
    [ -n "$t" ] || t="$( { grep -E '\| criada \| [^|]*: ' "$d/historico.md" 2>/dev/null || true; } | head -1 | sed -E 's/^- [^|]*\| criada \| [^|]*: (.*) \| por: .*$/\1/')"
    [ -n "$t" ] || t="$(basename "$d" | sed -E 's/^[0-9]{3}-//; s/-/ /g')"
    printf '%s (%s)\n' "$t" "$num"
    return 0
  done
}

# A seção da versão no formato Keep a Changelog. Commits de uma feature (escopo
# NNN) viram uma linha com o título dela, na categoria do maior impacto; os
# demais entram um a um. docs, chore, refactor, test, build, ci e style ficam de
# fora: não mudam o que o usuário vê.
secao_changelog() {
  local v="$1" base ref linhas
  base="$(versao_base)"; ref="$(ref_base "$base")"
  linhas="$(sdd_cc_commits "$RAIZ" "$ref")"
  local adic="" corr="" modi="" l imp tipo esc desc t chave vistos="" impf
  while IFS="$(printf '\t')" read -r imp tipo esc desc; do
    [ -n "$imp" ] || continue
    [ "$esc" = "-" ] && esc=""
    case "$tipo" in feat|fix|perf) ;; *) [ "$imp" = "major" ] || continue ;; esac
    t="$(titulo_feature "$esc")"
    if [ -n "$t" ]; then
      chave="$esc"
      printf '%s' "$vistos" | grep -qx "$chave" && continue
      vistos="$vistos$chave"$'\n'
      impf="$(printf '%s\n' "$linhas" | awk -F '\t' -v e="$esc" '$3 == e' | impacto_maximo)"
      case "$impf" in
        major) modi="$modi- **Incompatível:** $t"$'\n' ;;
        minor) adic="$adic- $t"$'\n' ;;
        patch)
          if printf '%s\n' "$linhas" | awk -F '\t' -v e="$esc" '$3 == e && $2 == "fix"' | grep -q .; then corr="$corr- $t"$'\n'; else modi="$modi- $t"$'\n'; fi ;;
      esac
      continue
    fi
    l="$desc${esc:+ ($esc)}"
    if [ "$imp" = "major" ]; then modi="$modi- **Incompatível:** $l"$'\n'
    elif [ "$tipo" = "feat" ]; then adic="$adic- $l"$'\n'
    elif [ "$tipo" = "fix" ]; then corr="$corr- $l"$'\n'
    else modi="$modi- $l"$'\n'
    fi
  done <<< "$linhas"
  printf '## [%s] - %s\n' "$v" "$HOJE"
  [ -n "$adic" ] && printf '\n### Adicionado\n\n%s' "$adic"
  [ -n "$modi" ] && printf '\n### Modificado\n\n%s' "$modi"
  [ -n "$corr" ] && printf '\n### Corrigido\n\n%s' "$corr"
  if [ -z "$adic$modi$corr" ]; then printf '\nSem mudanças visíveis: só manutenção.\n'; fi
  return 0
}

escrever_changelog() { # escrever_changelog <versão> <seção>
  local v="$1" secao="$2" arq="$RAIZ/CHANGELOG.md" tmp
  if [ -f "$arq" ] && grep -qE "^## \[$v\]" "$arq"; then
    echo "sdd-release changelog: o CHANGELOG.md já tem a seção [$v]. Edite à mão, se precisar." >&2
    exit 1
  fi
  if [ ! -f "$arq" ]; then
    {
      printf '# Changelog\n\n'
      printf 'As mudanças relevantes de cada versão. Formato [Keep a Changelog](https://keepachangelog.com/pt-BR/1.1.0/),\n'
      printf 'versões [SemVer](https://semver.org/lang/pt-BR/). Gerado pelo `sdd-release changelog` a partir dos commits\n'
      printf '(Conventional Commits), e revisado por quem faz a release.\n\n'
      printf '## [Não lançado]\n'
    } > "$arq"
  fi
  tmp="$arq.tmp.$$"
  printf '%s\n' "$secao" > "$tmp.secao"
  # Entra logo antes da primeira versão já lançada, depois do "Não lançado".
  awk -v sf="$tmp.secao" '
    !feito && /^## \[/ && $0 !~ /^## \[(Não lançado|Unreleased)\]/ {
      while ((getline l < sf) > 0) print l
      print ""
      feito = 1
    }
    { print }
    END { if (!feito) { print ""; while ((getline l < sf) > 0) print l } }
  ' "$arq" > "$tmp"
  mv "$tmp" "$arq"; rm -f "$tmp.secao"
  echo "CHANGELOG.md: seção [$v] gravada. Revise o texto antes do commit."
}

cmd="${1:-listar}"
shift || true

case "$cmd" in
  proxima)
    tipo="auto"; pre=""
    while [ $# -gt 0 ]; do
      case "$1" in
        auto|major|minor|patch) tipo="$1" ;;
        --pre) pre="${2:?--pre exige um identificador (alpha, beta, rc)}"; shift ;;
        *) echo "sdd-release proxima: use auto, major, minor ou patch, e --pre <id>" >&2; exit 1 ;;
      esac
      shift
    done
    proxima_versao "$tipo" "$pre"
    ;;

  analisar)
    analisar
    ;;

  changelog)
    v=""; escrever=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --escrever) escrever=1 ;;
        -*) echo "sdd-release changelog: opção desconhecida $1" >&2; exit 1 ;;
        *) v="$1" ;;
      esac
      shift
    done
    [ -n "$v" ] || { echo "uso: sdd-release changelog <versão> [--escrever]" >&2; exit 1; }
    sdd_semver_valida "$v" || { echo "sdd-release: versão inválida: $v" >&2; exit 1; }
    secao="$(secao_changelog "$v")"
    if [ "$escrever" -eq 1 ]; then
      escrever_changelog "$v" "$secao"
    else
      printf '%s\n' "$secao"
    fi
    ;;

  nova)
    v=""; objetivo=""; tipo=normal
    while [ $# -gt 0 ]; do
      case "$1" in
        --objetivo) objetivo="${2:?}"; shift ;;
        --hotfix) tipo=hotfix ;;
        -*) echo "sdd-release nova: opção desconhecida $1" >&2; exit 1 ;;
        *) v="$1" ;;
      esac
      shift
    done
    [ -n "$v" ] || { echo "uso: sdd-release nova <versão> [--objetivo texto] [--hotfix]" >&2; exit 1; }
    sdd_semver_valida "$v" || { echo "sdd-release: '$v' não é uma versão SemVer (ex.: 1.4.0)" >&2; exit 1; }
    [ ! -d "$DIR/$v" ] || { echo "sdd-release: a release $v já existe." >&2; exit 1; }
    mkdir -p "$DIR/$v"
    obj_sed="$(printf '%s' "${objetivo:-a definir}" | sed 's/[\/&|]/\\&/g')"
    for t in release testes homologacao implantacao notas; do
      sed -e "s/{{VERSAO}}/$v/g" -e "s/{{TIPO}}/$tipo/g" -e "s/{{OBJETIVO}}/$obj_sed/g" -e "s/{{DATA}}/$HOJE/g" \
        "$(sdd_template "$RAIZ" "release/$t.md")" > "$DIR/$v/$t.md"
    done
    printf 'fase=preparacao\ntipo=%s\natualizado=%s\n' "$tipo" "$(sdd_agora)" > "$DIR/$v/estado"
    historico "$v" criada "$tipo${objetivo:+: $objetivo}"
    echo "Release $v criada em $PASTA/$v/ (situação: preparacao)."
    ;;

  incluir)
    v="${1:?uso: sdd-release incluir <versão> <NNN-slug> [...]}"; shift
    existe "$v"; exige "$v" preparacao
    [ $# -gt 0 ] || { echo "sdd-release incluir: informe ao menos uma feature." >&2; exit 1; }
    for f in "$@"; do
      [ -d "$RAIZ/$PASTA_SPECS/$f" ] || { echo "sdd-release: a feature $f não existe." >&2; exit 1; }
      fase="$(sdd_feature_ler "$RAIZ" "$f" fase)"
      [ "$fase" = "pronta" ] || { echo "sdd-release: a feature $f está em '$fase'. Só entram features prontas." >&2; exit 1; }
      outra="$(sdd_feature_ler "$RAIZ" "$f" release)"
      if [ -n "$outra" ] && [ "$outra" != "$v" ]; then
        echo "sdd-release: a feature $f já está na release $outra." >&2; exit 1
      fi
      if features "$v" | grep -qx "$f"; then echo "$f já está na release $v."; continue; fi
      reescrever_features "$v" "$( { features "$v"; printf '%s\n' "$f"; } )"
      sdd_feature_gravar "$RAIZ" "$f" release "$v"
      sdd_registrar "$RAIZ" "$f" release "incluída na release $v"
      historico "$v" inclusao "$f"
      echo "$f incluída na release $v."
    done
    ;;

  remover)
    v="${1:?uso: sdd-release remover <versão> <NNN-slug>}"; f="${2:?}"
    existe "$v"; exige "$v" preparacao
    features "$v" | grep -qx "$f" || { echo "sdd-release: $f não está na release $v." >&2; exit 1; }
    reescrever_features "$v" "$(features "$v" | grep -vx "$f" || true)"
    sdd_feature_gravar "$RAIZ" "$f" release ""
    sdd_registrar "$RAIZ" "$f" release "removida da release $v"
    historico "$v" remocao "$f"
    echo "$f removida da release $v."
    ;;

  homologar)
    v="${1:?uso: sdd-release homologar <versão>}"
    existe "$v"; exige "$v" preparacao
    lista="$(features "$v")"
    [ -n "$lista" ] || { echo "sdd-release: a release $v não tem features." >&2; exit 1; }
    problemas=()
    for f in $lista; do
      fase="$(sdd_feature_ler "$RAIZ" "$f" fase)"
      [ "$fase" = "pronta" ] || problemas+=("$f está em '$fase', não em 'pronta'")
      pend="$(sdd_pendencias_para_pronta "$RAIZ" "$f")"
      [ -z "$pend" ] || problemas+=("$f: $(printf '%s' "$pend" | head -1)")
    done
    t="$DIR/$v/testes.md"
    sdd_md_sem_lacunas "$t" || problemas+=("testes.md ainda tem campos {{...}} (rode os testes de sistema)")
    [ "$(sdd_md_campo "$t" Resultado)" = "aprovado" ] || problemas+=("testes.md não está com 'Resultado | aprovado'")
    grep -qE '^\| H-[0-9]+ ' "$DIR/$v/homologacao.md" || problemas+=("homologacao.md não tem o roteiro (linhas | H-NNN |)")
    if [ ${#problemas[@]} -gt 0 ]; then
      echo "sdd-release: a release $v ainda não pode ir para homologação:" >&2
      printf '  - %s\n' "${problemas[@]}" >&2
      exit 1
    fi
    historico "$v" testes "testes de sistema aprovados | hash=$(sdd_hash_stdin < "$t")"
    mudar_situacao "$v" homologacao ""
    transicionar_features "$v" homologacao "release $v em homologação"
    echo "Release $v em homologação. Quem homologa executa o roteiro em $PASTA/$v/homologacao.md."
    ;;

  aceitar)
    v="${1:?uso: sdd-release aceitar <versão> --por \"Nome e papel\" [--nota texto]}"; shift
    por=""; nota=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --por) por="${2:?}"; shift ;;
        --nota) nota="${2:?}"; shift ;;
        *) echo "sdd-release aceitar: opção desconhecida $1" >&2; exit 1 ;;
      esac
      shift
    done
    [ -n "$por" ] || { echo "sdd-release aceitar: informe --por (quem homologou)." >&2; exit 1; }
    existe "$v"; exige "$v" homologacao
    problema="$(roteiro_ok "$v")"
    [ -z "$problema" ] || { echo "sdd-release: $problema." >&2; exit 1; }
    h="$(sdd_hash_stdin < "$DIR/$v/homologacao.md")"
    historico "$v" aceite "por: $por | hash=$h${nota:+ | nota: $nota}"
    mudar_situacao "$v" aceita "aceite de $por"
    case "$v" in
      *-*) echo "Aceite registrado (por $por). $v é um pré-lançamento: ele não vai para produção. Próximo: sdd-release cancelar $v --motivo \"substituída pela ${v%%-*}\" e a release ${v%%-*} com as mesmas features." ;;
      *) echo "Aceite registrado (por $por). Próximo: plano de implantação e go/no-go (sdd-release autorizar $v)." ;;
    esac
    ;;

  reprovar)
    v="${1:?uso: sdd-release reprovar <versão> <NNN-slug> --motivo texto}"; f="${2:?}"; shift 2
    motivo=""
    while [ $# -gt 0 ]; do
      case "$1" in --motivo) motivo="${2:?}"; shift ;; *) echo "sdd-release reprovar: opção desconhecida $1" >&2; exit 1 ;; esac
      shift
    done
    [ -n "$motivo" ] || { echo "sdd-release reprovar: informe --motivo." >&2; exit 1; }
    existe "$v"; exige "$v" homologacao aceita
    features "$v" | grep -qx "$f" || { echo "sdd-release: $f não está na release $v." >&2; exit 1; }
    "$AQUI/sdd-estado" reabrir "$f" --pela-release --fase green --motivo "reprovada na homologação da $v: $motivo" >/dev/null
    # Com o Git Flow, a correção é feita na branch da release, e a feature passa
    # a ser trabalhada nela (sdd-gitflow esperada, o hook e o integrar sabem disso).
    if sdd_gitflow_ativo "$RAIZ" && git -C "$RAIZ" show-ref --verify --quiet "refs/heads/release/$v"; then
      sdd_feature_gravar "$RAIZ" "$f" branch "release/$v"
    fi
    reescrever_features "$v" "$(features "$v" | grep -vx "$f" || true)"
    for g in $(features "$v"); do "$AQUI/sdd-estado" transicionar "$g" pronta "release $v voltou à preparação" >/dev/null; done
    historico "$v" reprovacao "$f: $motivo"
    mudar_situacao "$v" preparacao "feature $f reprovada"
    echo "$f reprovada e reaberta no green. A release $v voltou à preparação."
    if [ "$(sdd_feature_ler "$RAIZ" "$f" branch)" = "release/$v" ]; then
      echo "A correção é feita em release/$v. Com a feature pronta de novo: sdd-release incluir $v $f, e refaça os testes de sistema e a homologação."
    else
      echo "Com a feature pronta de novo: sdd-release incluir $v $f, e refaça os testes de sistema e a homologação."
    fi
    ;;

  autorizar)
    v="${1:?uso: sdd-release autorizar <versão> [--nota texto]}"; shift
    case "$v" in *-*)
      echo "sdd-release autorizar: $v é um pré-lançamento, que só é homologado. Para produção, prepare a versão final (${v%%-*})." >&2; exit 1 ;;
    esac
    nota=""
    while [ $# -gt 0 ]; do
      case "$1" in --nota) nota="${2:?}"; shift ;; *) echo "sdd-release autorizar: opção desconhecida $1" >&2; exit 1 ;; esac
      shift
    done
    existe "$v"; exige "$v" aceita
    problemas=()
    sdd_md_sem_lacunas "$DIR/$v/implantacao.md" || problemas+=("implantacao.md ainda tem campos {{...}} (passos, verificação e rollback)")
    grep -q '^## Rollback' "$DIR/$v/implantacao.md" || problemas+=("implantacao.md não tem a seção Rollback")
    sdd_md_sem_lacunas "$DIR/$v/notas.md" || problemas+=("notas.md ainda tem campos {{...}}")
    if [ ${#problemas[@]} -gt 0 ]; then
      echo "sdd-release: a release $v ainda não pode ser autorizada:" >&2
      printf '  - %s\n' "${problemas[@]}" >&2
      exit 1
    fi
    h="$(sdd_hash_stdin < "$DIR/$v/implantacao.md")"
    historico "$v" autorizacao "go | hash=$h${nota:+ | nota: $nota}"
    mudar_situacao "$v" implantacao "go"
    echo "Implantação da $v autorizada (go). Siga $PASTA/$v/implantacao.md e, ao terminar a verificação, rode 'sdd-release concluir $v'."
    ;;

  pode-implantar)
    v="${1:?uso: sdd-release pode-implantar <versão>}"
    v="${v#v}"
    [ -f "$DIR/$v/release.md" ] || { echo "release $v não existe"; exit 1; }
    s="$(situacao "$v")"
    case "$s" in
      implantacao|producao) echo "release $v autorizada ($s)"; exit 0 ;;
      *) echo "release $v não autorizada (situação: $s)"; exit 1 ;;
    esac
    ;;

  concluir)
    v="${1:?uso: sdd-release concluir <versão> --verificacao texto}"; shift
    verif=""
    while [ $# -gt 0 ]; do
      case "$1" in --verificacao) verif="${2:?}"; shift ;; *) echo "sdd-release concluir: opção desconhecida $1" >&2; exit 1 ;; esac
      shift
    done
    [ -n "$verif" ] || { echo "sdd-release concluir: informe --verificacao (o resultado da verificação pós-implantação)." >&2; exit 1; }
    existe "$v"; exige "$v" implantacao
    historico "$v" verificacao "$verif"
    mudar_situacao "$v" producao "em produção em $HOJE"
    transicionar_features "$v" producao "release $v em produção"
    if git -C "$RAIZ" rev-parse -q --verify "refs/tags/v$v" >/dev/null 2>&1; then
      echo "Release $v em produção. A tag v$v já existe (sdd-gitflow finalizar); se ainda não a publicou: git push origin v$v"
    else
      echo "Release $v em produção. Falta a tag: sdd-gitflow finalizar $v (com o Git Flow), ou git tag -a v$v -m \"versão $v\" && git push origin v$v"
    fi
    pend="$("$AQUI/sdd-sistema" pendentes 2>/dev/null || true)"
    if [ -n "$pend" ]; then
      echo "Atenção: features ainda não consolidadas na spec do sistema:"
      printf '%s\n' "$pend" | cut -f1 | sed 's/^/  - /'
    fi
    ;;

  reverter|cancelar)
    v="${1:?uso: sdd-release $cmd <versão> --motivo texto}"; shift
    motivo=""
    while [ $# -gt 0 ]; do
      case "$1" in --motivo) motivo="${2:?}"; shift ;; *) echo "sdd-release $cmd: opção desconhecida $1" >&2; exit 1 ;; esac
      shift
    done
    [ -n "$motivo" ] || { echo "sdd-release $cmd: informe --motivo." >&2; exit 1; }
    existe "$v"
    if [ "$cmd" = "reverter" ]; then
      exige "$v" implantacao producao
      nova=revertida
    else
      exige "$v" preparacao homologacao aceita
      nova=cancelada
    fi
    for f in $(features "$v"); do
      "$AQUI/sdd-estado" transicionar "$f" pronta "release $v $nova: $motivo" >/dev/null
      sdd_feature_gravar "$RAIZ" "$f" release ""
    done
    mudar_situacao "$v" "$nova" "$motivo"
    echo "Release $v $nova. As features voltaram a 'pronta' e podem entrar numa próxima release."
    ;;

  ver)
    v="${1:-}"
    [ -n "$v" ] || v="$("$0" atual 2>/dev/null || true)"
    [ -n "$v" ] || { echo "Nenhuma release em andamento."; exit 0; }
    existe "$v"
    echo "Release $v ($(situacao "$v"), $(sdd_kv_ler "$DIR/$v/estado" tipo)) · objetivo: $(sdd_md_campo "$DIR/$v/release.md" Objetivo)"
    for f in $(features "$v"); do
      printf '  %-34s %s\n' "$f" "$(sdd_feature_ler "$RAIZ" "$f" fase)"
    done
    echo "  documentos:"
    for d in testes homologacao implantacao notas; do
      if sdd_md_sem_lacunas "$DIR/$v/$d.md"; then echo "    ✓ $d.md"; else echo "    · $d.md (a preencher)"; fi
    done
    case "$(situacao "$v")" in
      preparacao) echo "  próximo: testes de sistema e roteiro de homologação, depois 'sdd-release homologar $v'" ;;
      homologacao) echo "  próximo: executar o roteiro e 'sdd-release aceitar $v --por \"Nome\"'" ;;
      aceita) echo "  próximo: plano de implantação, notas e 'sdd-release autorizar $v' (go/no-go)" ;;
      implantacao) echo "  próximo: implantar, verificar e 'sdd-release concluir $v --verificacao \"...\"'" ;;
    esac
    ;;

  listar)
    for v in $(versoes); do
      printf '%-12s %-12s %s · %s feature(s)\n' "$v" "$(situacao "$v")" "$(sdd_md_campo "$DIR/$v/release.md" Objetivo)" "$(features "$v" | grep -c . || true)"
    done
    ;;

  atual)
    ult=""
    for v in $(versoes); do
      case "$(situacao "$v")" in preparacao|homologacao|aceita|implantacao) ult="$v" ;; esac
    done
    [ -n "$ult" ] || exit 1
    printf '%s\n' "$ult"
    ;;

  -h|--ajuda|--help|ajuda)
    sdd_ajuda "$0"
    ;;

  *)
    echo "sdd-release: comando desconhecido '$cmd'. Use --ajuda." >&2
    exit 1
    ;;
esac
