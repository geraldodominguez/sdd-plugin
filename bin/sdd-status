#!/usr/bin/env bash
# sdd-status: a situação do projeto no SDD.
#
# Uso:
#   sdd-status               quadro: sprint atual, features por coluna, backlog e pendências
#   sdd-status <NNN-slug>    detalhe de uma feature
#   sdd-status --ativa       detalhe da feature ativa
set -uo pipefail

AQUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/sdd-comum.sh
. "$AQUI/../lib/sdd-comum.sh"

RAIZ="$(sdd_raiz_projeto)"
if [ ! -d "$RAIZ/.sdd" ]; then
  echo "Este projeto ainda não usa SDD. Rode /sdd:iniciar para começar."
  exit 0
fi
PASTA_SPECS="$(sdd_pasta_specs "$RAIZ")"
ATIVA="$(sdd_kv_ler "$RAIZ/.sdd/estado" feature)"
SPRINT="$(sdd_kv_ler "$RAIZ/.sdd/estado" sprint)"

coluna() {
  case "$1" in
    especificacao|clarificacao) echo "Especificação" ;;
    plano|tarefas) echo "Planejamento" ;;
    red|green) echo "Implementação" ;;
    seguranca|auditoria) echo "Revisão" ;;
    pronta) echo "Pronta" ;;
    homologacao) echo "Homologação" ;;
    producao) echo "Produção" ;;
    cancelada) echo "Cancelada" ;;
    *) echo "Sem fase" ;;
  esac
}

na_sprint() { # na_sprint <feature>
  [ -n "$SPRINT" ] || return 1
  local item origem
  origem="$(sdd_feature_ler "$RAIZ" "$1" origem)"
  for item in $("$AQUI/sdd-sprint" itens "$SPRINT" 2>/dev/null); do
    [ "$item" = "$1" ] && return 0
    [ -n "$origem" ] && [ "$item" = "$origem" ] && return 0
  done
  return 1
}

detalhe() { # detalhe <feature>
  local f="$1" dir fase nivel prog feitas total linha p a fora
  dir="$RAIZ/$PASTA_SPECS/$f"
  [ -d "$dir" ] || { echo "sdd-status: a feature $f não existe." >&2; exit 1; }
  fase="$(sdd_feature_ler "$RAIZ" "$f" fase)"; nivel="$(sdd_feature_ler "$RAIZ" "$f" nivel)"
  echo "Feature $f (nível ${nivel:-?})$( [ "$f" = "$ATIVA" ] && echo ' · ativa')"
  o="$(sdd_feature_ler "$RAIZ" "$f" origem)"; [ -n "$o" ] && echo "  origem: $o"
  t="$(sdd_feature_ler "$RAIZ" "$f" tipo)"; [ "$t" = "hotfix" ] && echo "  tipo: hotfix (spec retroativa obrigatória)"
  case "$(sdd_feature_ler "$RAIZ" "$f" adocao)" in
    transicao) echo "  adoção: EM TRANSIÇÃO (veio de outro processo; converta e aprove o transicao.md)" ;;
    regularizada) echo "  adoção: regularizada (veio de outro processo; ver transicao.md)" ;;
  esac
  echo "  revisão de segurança: $(sdd_feature_ler "$RAIZ" "$f" seguranca)"
  c="$(sdd_feature_ler "$RAIZ" "$f" capacidade)"; echo "  capacidade: ${c:-não definida}"
  r="$(sdd_feature_ler "$RAIZ" "$f" release)"; [ -n "$r" ] && echo "  release: $r"
  if sdd_fase_entregue "$fase"; then
    if "$AQUI/sdd-sistema" consolidada "$f" >/dev/null 2>&1; then echo "  spec do sistema: consolidada"; else echo "  spec do sistema: NÃO consolidada (/sdd:sistema)"; fi
  fi
  linha=""
  for p in $SDD_FASES; do
    if [ "$p" = "$fase" ]; then linha="$linha [$p]"; else linha="$linha $p"; fi
  done
  echo "  fase:$linha"
  echo "  artefatos:"
  for a in transicao.md contexto.md spec.md plano.md tarefas.md seguranca.md auditoria.md delta-spec.md; do
    [ -f "$dir/$a" ] || { case "$a" in delta-spec.md|transicao.md) continue ;; esac; echo "    · $a"; continue; }
    case "$a" in
      spec.md|plano.md|tarefas.md|seguranca.md|auditoria.md)
        st="$("$AQUI/sdd-estado" aprovado "$a" "$f" 2>/dev/null)"; st="${st#*: }"
        echo "    ✓ $a ($st)" ;;
      *) echo "    ✓ $a" ;;
    esac
  done
  [ -d "$dir/contratos" ] && echo "    ✓ contratos/ ($(find "$dir/contratos" -type f | wc -l | tr -d ' ') arquivos)"
  prog="$(sdd_tarefas_progresso "$RAIZ" "$f")"; feitas="${prog% *}"; total="${prog#* }"
  if [ "$total" -gt 0 ]; then
    fora="$(sdd_tarefas_fora "$RAIZ" "$f")"
    if [ "${fora:-0}" -gt 0 ]; then
      echo "  tarefas: $feitas/$total concluídas ($fora feitas fora do plugin, marcadas [O])"
    else
      echo "  tarefas: $feitas/$total concluídas"
    fi
    proxima="$(grep -E '^[[:space:]]*- \[ \][[:space:]]*\*{0,2}T-[0-9]{3}' "$dir/tarefas.md" | head -1 | sed -E 's/^[[:space:]]*- \[ \][[:space:]]*//')"
    [ -n "$proxima" ] && echo "  próxima: $proxima"
  fi
  n="$(sdd_duvidas_abertas "$RAIZ" "$f")"; [ "${n:-0}" -gt 0 ] && echo "  dúvidas em aberto: $n"
  aguarda="$(sdd_aguarda_aprovacao "$RAIZ" "$f")"; [ -n "$aguarda" ] && echo "  aguardando: aprovação de $aguarda (/sdd:aprovar)"
  echo
  "$AQUI/sdd-rastrear" "$f" 2>/dev/null || true
}

case "${1:-}" in
  --ativa)
    [ -n "$ATIVA" ] || { echo "Nenhuma feature ativa."; exit 0; }
    detalhe "$ATIVA"; exit 0 ;;
  "") ;;
  -h|--ajuda|--help) sed -n '2,7p' "$0"; exit 0 ;;
  *) detalhe "$1"; exit 0 ;;
esac

# ---------------------------------------------------------------- quadro
echo "SDD: $(basename "$RAIZ") · proteção $(sdd_config "$RAIZ" protecao leve)"
if [ -s "$RAIZ/.sdd/constituicao.md" ] && grep -q '{{' "$RAIZ/.sdd/constituicao.md"; then
  echo "! a constituição ainda tem campos {{...}} por preencher"
fi
echo

if [ -n "$SPRINT" ] && [ -f "$RAIZ/.sdd/sprints/$SPRINT.md" ]; then
  "$AQUI/sdd-sprint" ver "$SPRINT" | head -3
  echo
else
  echo "Sem sprint atual. (/sdd:sprint planejar)"
  echo
fi

linhas_coluna() { # linhas_coluna <título>
  local alvo="$1" f fase nivel extra prog feitas total n aguarda marca fora achou=0
  for f in $(sdd_features "$RAIZ"); do
    fase="$(sdd_feature_ler "$RAIZ" "$f" fase)"
    [ "$(coluna "$fase")" = "$alvo" ] || continue
    nivel="$(sdd_feature_ler "$RAIZ" "$f" nivel)"
    extra="$fase"
    prog="$(sdd_tarefas_progresso "$RAIZ" "$f")"; feitas="${prog% *}"; total="${prog#* }"
    em_construcao=1
    sdd_fase_entregue "$fase" && em_construcao=0
    [ "$total" -gt 0 ] && [ "$em_construcao" -eq 1 ] && extra="$extra · $feitas/$total tarefas"
    fora="$(sdd_tarefas_fora "$RAIZ" "$f")"
    [ "${fora:-0}" -gt 0 ] && [ "$em_construcao" -eq 1 ] && extra="$extra ($fora fora do plugin)"
    n="$(sdd_duvidas_abertas "$RAIZ" "$f")"
    [ "${n:-0}" -gt 0 ] && [ "$em_construcao" -eq 1 ] && extra="$extra · $n dúvida(s)"
    [ "$(sdd_feature_ler "$RAIZ" "$f" tipo)" = "hotfix" ] && extra="$extra · hotfix"
    [ "$(sdd_feature_ler "$RAIZ" "$f" adocao)" = "transicao" ] && extra="$extra · em transição"
    if [ "$em_construcao" -eq 1 ]; then
      aguarda="$(sdd_aguarda_aprovacao "$RAIZ" "$f")"
      [ -n "$aguarda" ] && extra="$extra · aguarda aprovação"
    else
      rel="$(sdd_feature_ler "$RAIZ" "$f" release)"
      [ -n "$rel" ] && extra="$extra · release $rel"
      "$AQUI/sdd-sistema" consolidada "$f" >/dev/null 2>&1 || extra="$extra · não consolidada"
    fi
    marca="  "
    na_sprint "$f" && marca="★ "
    [ "$f" = "$ATIVA" ] && marca="▶ "
    printf '  %s%-34s n%s · %s\n' "$marca" "$f" "${nivel:-?}" "$extra"
    achou=1
  done
  [ "$achou" -eq 1 ] || echo "    (vazia)"
}

echo "QUADRO   ▶ feature ativa   ★ na sprint atual"
for col in "Especificação" "Planejamento" "Implementação" "Revisão" "Pronta" "Homologação"; do
  echo "$col"
  linhas_coluna "$col"
done
conta_fase() { local f n=0; for f in $(sdd_features "$RAIZ"); do [ "$(sdd_feature_ler "$RAIZ" "$f" fase)" = "$1" ] && n=$((n + 1)); done; echo "$n"; }
echo "Produção: $(conta_fase producao) feature(s) · Cancelada: $(conta_fase cancelada)"
echo

rel="$("$AQUI/sdd-release" atual 2>/dev/null || true)"
if [ -n "$rel" ]; then
  echo "RELEASE"
  "$AQUI/sdd-release" ver "$rel" 2>/dev/null | sed 's/^/  /' | head -12
  echo
fi

ninc="$("$AQUI/sdd-incidente" listar --abertos 2>/dev/null | grep -c '^INC-' || true)"
if [ "${ninc:-0}" -gt 0 ]; then
  echo "INCIDENTES ABERTOS: $ninc"
  "$AQUI/sdd-incidente" listar --abertos 2>/dev/null | sed 's/^/  /'
  echo
fi

nb="$("$AQUI/sdd-backlog" contar 2>/dev/null || echo 0)"
echo "BACKLOG: $nb item(ns) aberto(s)"
if [ "${nb:-0}" -gt 0 ]; then
  "$AQUI/sdd-backlog" listar 2>/dev/null | head -5 | sed 's/^/  /'
  [ "$nb" -gt 5 ] && echo "  ... (/sdd:backlog para ver todos)"
fi
echo

np="$("$AQUI/sdd-pendencias" --contar 2>/dev/null || echo 0)"
if [ "${np:-0}" -gt 0 ]; then
  echo "ESPERANDO VOCÊ: $np item(ns) (/sdd:pendencias)"
else
  echo "ESPERANDO VOCÊ: nada"
fi
