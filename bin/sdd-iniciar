#!/usr/bin/env bash
# sdd-iniciar: prepara um projeto para usar SDD.
#
# Uso: sdd-iniciar [--forcar] [--nivel 1|2] [--protecao desligada|leve|estrita]
#
# Cria, sem sobrescrever o que já existe (a menos que --forcar):
#   .sdd/config.yml        configuração do projeto
#   .sdd/constituicao.md   regras inegociáveis (a preencher)
#   .sdd/estado            ponteiros pessoais: feature ativa e sprint atual
#   .sdd/backlog.md        itens ainda sem spec
#   .sdd/sprints/          uma sprint por arquivo
#   .sdd/templates/        cópia dos templates do plugin (customizável)
#   specs/                 uma pasta por feature (o que cada mudança alterou)
#   sistema/               a spec viva do sistema, por capacidade (o que ele faz hoje)
#   releases/, incidentes/ criadas sob demanda por /sdd:release e /sdd:incidente
#   docs/adr/              decisões arquiteturais duráveis
# E injeta o bloco de regras SDD em CLAUDE.md e AGENTS.md (idempotente), e
# acrescenta ao .gitattributes o merge por união dos históricos: com o Git Flow,
# duas branches acrescentam linhas ao mesmo histórico, e o merge junta as duas.
#
# Num projeto que já usa o SDD, rodar de novo (sem --forcar) é a atualização:
# cria só o que falta, atualiza o bloco e o .gitattributes, e não toca no que
# existe. Ele lista os templates que diferem dos do plugin (o projeto pode tê-los
# customizado) e as chaves do config.yml que o projeto ainda não tem (valem os
# padrões do plugin). Com --forcar, sobrescreve config, constituição e templates.
set -euo pipefail

AQUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/sdd-comum.sh
. "$AQUI/../lib/sdd-comum.sh"
case "${1:-}" in -h|--ajuda|--help) sdd_ajuda "$0"; exit 0 ;; esac

FORCAR=0
NIVEL=1
PROTECAO=leve
while [ $# -gt 0 ]; do
  case "$1" in
    --forcar) FORCAR=1 ;;
    --nivel) NIVEL="${2:?--nivel exige um valor}"; shift ;;
    --protecao) PROTECAO="${2:?--protecao exige um valor}"; shift ;;
    -h|--ajuda|--help) sdd_ajuda "$0"; exit 0 ;;
    *) echo "sdd-iniciar: opção desconhecida: $1" >&2; exit 1 ;;
  esac
  shift
done

case "$NIVEL" in 1|2) ;; *) echo "sdd-iniciar: --nivel deve ser 1 ou 2" >&2; exit 1 ;; esac
case "$PROTECAO" in desligada|leve|estrita) ;; *) echo "sdd-iniciar: --protecao deve ser desligada, leve ou estrita" >&2; exit 1 ;; esac

RAIZ_PLUGIN="$(sdd_raiz_plugin)"
RAIZ="${CLAUDE_PROJECT_DIR:-$(pwd)}"
ORIGEM="$RAIZ_PLUGIN/skills/metodologia/templates"

if [ ! -d "$ORIGEM" ]; then
  echo "sdd-iniciar: templates não encontrados em $ORIGEM" >&2
  exit 1
fi

criados=()
mantidos=()
diferentes=()
ATUALIZACAO=0
[ -e "$RAIZ/.sdd/config.yml" ] && ATUALIZACAO=1

copiar() {
  local de="$1" para="$2"
  if [ -e "$para" ] && [ "$FORCAR" -ne 1 ]; then
    mantidos+=("${para#"$RAIZ"/}")
    cmp -s "$de" "$para" || diferentes+=("${para#"$RAIZ"/}")
    return
  fi
  mkdir -p "$(dirname "$para")"
  cp "$de" "$para"
  criados+=("${para#"$RAIZ"/}")
}

mkdir -p "$RAIZ/.sdd/templates/release" "$RAIZ/specs" "$RAIZ/docs/adr" "$RAIZ/sistema"
if [ ! -e "$RAIZ/sistema/README.md" ]; then
  cp "$ORIGEM/sistema-readme.md" "$RAIZ/sistema/README.md"
  criados+=("sistema/README.md")
fi

# Templates: cópia local, para o projeto customizar sem afetar o plugin.
for f in "$ORIGEM"/*.md; do
  [ "$(basename "$f")" = "bloco-agentes.md" ] && continue
  copiar "$f" "$RAIZ/.sdd/templates/$(basename "$f")"
done
for f in "$ORIGEM"/release/*.md; do
  copiar "$f" "$RAIZ/.sdd/templates/release/$(basename "$f")"
done

# A constituição é sempre do projeto: não entra na lista de diferentes.
if [ -e "$RAIZ/.sdd/constituicao.md" ] && [ "$FORCAR" -ne 1 ]; then
  mantidos+=(".sdd/constituicao.md")
else
  copiar "$ORIGEM/constituicao.md" "$RAIZ/.sdd/constituicao.md"
fi

CONFIG="$RAIZ/.sdd/config.yml"
if [ ! -e "$CONFIG" ] || [ "$FORCAR" -eq 1 ]; then
  sed -e "s/^nivel_padrao: .*/nivel_padrao: $NIVEL/" \
      -e "s/^protecao: [a-z]*/protecao: $PROTECAO/" \
      "$ORIGEM/config.yml" > "$CONFIG"
  criados+=(".sdd/config.yml")
else
  mantidos+=(".sdd/config.yml")
fi

# Chaves do config do plugin que o config do projeto ainda não tem.
faltam=()
while IFS= read -r linha; do
  chave="${linha%%:*}"
  grep -qE "^${chave}:" "$CONFIG" && continue
  valor="$(printf '%s' "${linha#*:}" | sed -E 's/#.*$//; s/^[[:space:]]+//; s/[[:space:]]+$//')"
  faltam+=("$chave: ${valor:-(vazio)}")
done < <(grep -E '^[a-z_]+:' "$ORIGEM/config.yml")

if [ ! -e "$RAIZ/.sdd/estado" ]; then
  printf 'feature=\nsprint=\n' > "$RAIZ/.sdd/estado"
  criados+=(".sdd/estado")
fi

# O ponteiro de feature ativa é pessoal; o estado de cada feature é versionado.
if [ ! -e "$RAIZ/.sdd/.gitignore" ]; then
  printf '# Ponteiros pessoais (feature ativa e sprint atual) ficam fora do git.\nestado\n*.tmp.*\n' > "$RAIZ/.sdd/.gitignore"
  criados+=(".sdd/.gitignore")
fi

if [ ! -e "$RAIZ/.sdd/backlog.md" ]; then
  cp "$ORIGEM/backlog.md" "$RAIZ/.sdd/backlog.md"
  criados+=(".sdd/backlog.md")
fi
mkdir -p "$RAIZ/.sdd/sprints"
[ -e "$RAIZ/.sdd/sprints/.gitkeep" ] || touch "$RAIZ/.sdd/sprints/.gitkeep"

[ -e "$RAIZ/specs/.gitkeep" ] || touch "$RAIZ/specs/.gitkeep"
[ -e "$RAIZ/docs/adr/.gitkeep" ] || touch "$RAIZ/docs/adr/.gitkeep"

# Bloco de regras em CLAUDE.md e AGENTS.md, entre marcadores.
BLOCO="$ORIGEM/bloco-agentes.md"
injetar_bloco() {
  local alvo="$1"
  local ini='<!-- sdd:inicio -->' fim='<!-- sdd:fim -->'
  if [ -f "$alvo" ] && grep -qF "$ini" "$alvo"; then
    local tmp="$alvo.tmp.$$"
    awk -v b="$ini" -v e="$fim" -v bf="$BLOCO" '
      $0 == b { while ((getline linha < bf) > 0) print linha; pular = 1; next }
      $0 == e { pular = 0; next }
      !pular { print }
    ' "$alvo" > "$tmp"
    mv "$tmp" "$alvo"
    criados+=("${alvo#"$RAIZ"/} (bloco SDD atualizado)")
  else
    { [ -f "$alvo" ] && [ -s "$alvo" ] && printf '\n'; cat "$BLOCO"; } >> "$alvo"
    criados+=("${alvo#"$RAIZ"/} (bloco SDD adicionado)")
  fi
}
injetar_bloco "$RAIZ/CLAUDE.md"
injetar_bloco "$RAIZ/AGENTS.md"

# Históricos só recebem linhas novas: no merge entre branches do Git Flow, o
# driver "union" do git junta as linhas dos dois lados em vez de dar conflito.
ATRIB="$RAIZ/.gitattributes"
if ! grep -qF '# sdd:inicio' "$ATRIB" 2>/dev/null; then
  PS_="$(sdd_pasta_specs "$RAIZ")"; PR_="$(sdd_pasta_releases "$RAIZ")"
  {
    [ -s "$ATRIB" ] && printf '\n'
    printf '# sdd:inicio (históricos do SDD só recebem linhas: o merge junta os dois lados)\n'
    printf '.sdd/historico.md merge=union\n%s/*/historico.md merge=union\n%s/*/historico.md merge=union\n' "$PS_" "$PR_"
    printf '# sdd:fim\n'
  } >> "$ATRIB"
  criados+=(".gitattributes (merge por união dos históricos)")
fi

echo "SDD iniciado em: $RAIZ"
echo "  nível padrão: $NIVEL | proteção: $PROTECAO"
if [ ${#criados[@]} -gt 0 ]; then
  echo "Criado ou atualizado:"
  printf '  + %s\n' "${criados[@]}"
fi
if [ ${#mantidos[@]} -gt 0 ]; then
  echo "Mantido (já existia, não foi alterado):"
  printf '  = %s\n' "${mantidos[@]}"
fi
if [ ${#diferentes[@]} -gt 0 ]; then
  echo "Templates diferentes dos do plugin (compare antes de trocar: o projeto pode tê-los customizado):"
  printf '  ~ %s\n' "${diferentes[@]}"
fi
if [ ${#faltam[@]} -gt 0 ]; then
  echo "Chaves que o .sdd/config.yml não tem (até serem acrescentadas, vale o padrão do plugin):"
  printf '  ? %s\n' "${faltam[@]}"
fi
echo
if [ "$ATUALIZACAO" -eq 1 ] && [ "$FORCAR" -ne 1 ]; then
  echo "Projeto atualizado. Revise os templates e as chaves acima; a constituição e o config não foram alterados."
else
  echo "Próximo passo: preencher .sdd/constituicao.md e revisar .sdd/config.yml."
fi
